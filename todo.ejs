<!DOCTYPE html>
<html>
<head>
  <title>Simple ToDo List</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 600px;
      margin: 40px auto;
    }
    h2 {
      text-align: center;
      color: gold;
    }
    ul {
      padding-left: 0;
    }
    li {
      list-style: none;
      padding: 10px;
      margin-bottom: 5px;
      background: #f0f0f0;
      display: flex;
      justify-content: space-between;
    }
    form {
      display: block;
      margin: 0 auto;
      text-align: center;
      width: 300px;
      color: red;
    }
  </style>
</head>
<body>
  <h1>My To Do List</h1>
  <form action="/add" method="POST">
    <input type="text" name="task" placeholder="Enter your task please" required>
    <button type="submit">Add</button>
  </form>
  <ul>
    <% tasks.forEach(task => { %>
      <li>
        <form action="/delete" method="POST" style="display:inline;">
          <input type="hidden" name="task" value="<%= task %>">
          <%= task %>
          <button type="submit">Delete</button>
        </form>
      </li>
    <% }); %>
  </ul>
  <ul>
    <% tasks.forEach(function(task) { %>
      <li><%= task %></li>
    <% }); %>
  </ul>
</body>
</html>